{
  "redirects": [
    {
      "source": "/glance",
      "destination": "/glance/",
      "permanent": true
    },
    {
      "source": "/projects/gskpromx",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/thrivent-fp",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/glance/",
      "destination": "/glance/index.html"
    },
    {
      "source": "/glance/:match*",
      "destination": "/glance/:match*"
    },
    {
      "source": "/proposta-:slug",
      "destination": "/api/proposta?slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
