{
  "redirects": [
    {
      "source": "/glance",
      "destination": "https://glance.maycondouglas.work/",
      "permanent": true
    },
    {
      "source": "/glance/",
      "destination": "https://glance.maycondouglas.work/",
      "permanent": true
    },
    {
      "source": "/glance/:path*",
      "destination": "https://glance.maycondouglas.work/:path*",
      "permanent": true
    },
    {
      "source": "/projects/gskpromx",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/thrivent-fp",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/proposta-:slug",
      "destination": "/api/proposta?slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
